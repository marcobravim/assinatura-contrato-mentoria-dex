Options -MultiViews
RewriteEngine On

# SPA fallback: toda request que não bate em arquivo/pasta existente vai pro index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Cache forte para assets hashados (Vite já hasha nome do arquivo)
<FilesMatch "\.(js|css|woff2?|png|jpg|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Sem cache do index.html (precisa atualizar após deploy)
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
